{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kidscade",
  "compatibility_date": "2026-09-15",
  "main": "./worker/main.mjs",
  "vars": { "HISTORY_LIVE_V2": "true", "HISTORY_LIVE_V2_PERCENT": "10" },
  "ratelimits": [
    { "name": "HISTORY_CREATE_LIMIT", "namespace_id": "9232601", "simple": { "limit": 20, "period": 60 } },
    { "name": "HISTORY_REQUEST_LIMIT", "namespace_id": "9232602", "simple": { "limit": 120, "period": 60 } },
    { "name": "HISTORY_ANON_LIMIT", "namespace_id": "9232603", "simple": { "limit": 600, "period": 60 } }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HISTORY_ROOMS", "class_name": "HistoryQuizRoom" }]
  },
  "migrations": [{ "tag": "history-room-v1", "new_sqlite_classes": ["HistoryQuizRoom"] }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kidscade-stats",
      "database_id": "3c0aa71d-5a3a-417b-a0f8-afc8d9022544",
      "migrations_dir": "migrations"
    }
  ]
}
